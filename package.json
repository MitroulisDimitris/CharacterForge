{
  "name": "character-forge",
  "private": true,
  "version": "0.1.0",
  "description": "Character builder for a 2024-rules Sorcerer, levels 1-5.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview": "vite preview",
    "pdf:sample": "vite build --ssr scripts/sample-pdf.ts --outDir .sample-build --emptyOutDir && node .sample-build/sample-pdf.js"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.8.3",
    "vite": "^7.1.0",
    "vitest": "^3.2.7"
  }
}
